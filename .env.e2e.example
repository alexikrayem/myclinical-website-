# E2E/Test Environment (copy to .env.e2e and fill with TEST credentials)

# Backend
NODE_ENV=development
PORT=5001
JWT_SECRET=change-me-to-a-long-random-value
SUPABASE_URL=https://your-test-project.supabase.co
SUPABASE_ANON_KEY=your-test-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-test-service-role-key
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:5173,http://localhost:5174
MOCK_VIDEO_API=true
MUX_DEFAULT_PLAYBACK_POLICY=public
PLAYBACK_SESSION_GRACE_SECONDS=900
MUX_TOKEN_GRACE_SECONDS=900

# Frontend (Vite)
VITE_API_URL=http://127.0.0.1:5001
VITE_SUPABASE_URL=https://your-test-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-test-anon-key
VITE_SENTRY_DSN=

# E2E Test Credentials
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=change-me
E2E_API_URL=http://127.0.0.1:5001
E2E_USE_MOCKS=0
