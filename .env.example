# Frontend Configuration
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend API URL
VITE_API_URL=http://localhost:5000

# Backend video playback
# Use mux://signed/<playback-id> for signed Mux assets or mux://public/<playback-id> for public Mux assets.
MUX_DEFAULT_PLAYBACK_POLICY=signed
MUX_SIGNING_KEY_ID=your_mux_signing_key_id
# Paste PEM with literal \n sequences, or the base64-encoded PEM returned by Mux.
MUX_SIGNING_PRIVATE_KEY=your_mux_signing_private_key
MUX_PLAYBACK_RESTRICTION_ID=
PLAYBACK_SESSION_GRACE_SECONDS=900
MUX_TOKEN_GRACE_SECONDS=900

# Meilisearch (Docker)
MEILI_MASTER_KEY=your_meili_master_key
